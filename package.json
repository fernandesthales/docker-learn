{
  "name": "task-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Live task board with React, Node.js and PostgreSQL",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "build": "vite build",
    "dev:web": "vite --host 127.0.0.1",
    "test:e2e": "playwright test",
    "secrets": "node scripts/generate-secrets.js"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "vite": "^8.3.5"
  }
}
